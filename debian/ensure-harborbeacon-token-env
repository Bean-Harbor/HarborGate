#!/bin/bash
set -euo pipefail

mode="${1:-prepare}"
auth_dir="${HARBOR_SERVICE_AUTH_DIR:-/etc/harboros/service-auth}"
legacy_env_file="${HARBOR_LEGACY_SHARED_ENV_FILE:-/etc/default/harboros-beacon-gate}"
stage_dir=""
backup_dir=""
transaction_started=0

credential_names=(
  gate-to-beacon.send
  gate-to-beacon.accept-current
  gate-to-beacon.accept-previous
  beacon-to-gate.send
  beacon-to-gate.accept-current
  beacon-to-gate.accept-previous
)

sync_path() {
  sync -f "$1"
}

cleanup() {
  local status="$?"
  local name
  trap - EXIT

  if [ "$status" -ne 0 ] && [ "$transaction_started" -eq 1 ]; then
    for name in "${credential_names[@]}"; do
      if [ -f "$backup_dir/$name" ]; then
        mv -f -- "$backup_dir/$name" "$auth_dir/$name"
        sync_path "$auth_dir/$name" || true
      else
        rm -f -- "$auth_dir/$name"
      fi
    done
    sync_path "$auth_dir" || true
  fi

  [ -z "$stage_dir" ] || rm -rf -- "$stage_dir"
  [ -z "$backup_dir" ] || rm -rf -- "$backup_dir"
  exit "$status"
}
trap cleanup EXIT

valid_token() {
  [[ "$1" =~ ^[A-Za-z0-9_-]{32,}$ ]]
}

read_token_file() {
  local path="$1"
  local value=""
  [ -f "$path" ] || return 0
  IFS= read -r value < "$path" || true
  printf '%s' "$value"
}

read_env_value() {
  local key="$1"
  local line
  local value=""
  [ -f "$legacy_env_file" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      "${key}="*) value="${line#*=}" ;;
    esac
  done < "$legacy_env_file"
  printf '%s' "$value"
}

first_valid_legacy() {
  local key
  local value
  for key in "$@"; do
    value="$(read_env_value "$key")"
    if valid_token "$value"; then
      printf '%s' "$value"
      return 0
    fi
  done
  return 0
}

generate_token() {
  local token=""
  if command -v openssl >/dev/null 2>&1; then
    token="$(openssl rand -hex 32 2>/dev/null || true)"
  fi
  if ! valid_token "$token"; then
    token="$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')"
  fi
  valid_token "$token"
  printf '%s' "$token"
}

generate_unique_token() {
  local token
  while true; do
    token="$(generate_token)"
    if [[ "$token" != "${1:-}" && "$token" != "${2:-}" && "$token" != "${3:-}" ]]; then
      printf '%s' "$token"
      return 0
    fi
  done
}

validate_target() {
  local path="$1"
  if [ -L "$path" ] || { [ -e "$path" ] && [ ! -f "$path" ]; }; then
    echo "refusing unsafe service-auth credential target" >&2
    exit 1
  fi
}

commit_credentials() {
  local name
  local count=0

  stage_dir="$(mktemp -d "$auth_dir/.stage.XXXXXX")"
  backup_dir="$(mktemp -d "$auth_dir/.backup.XXXXXX")"
  chmod 0700 "$stage_dir" "$backup_dir"

  printf '%s\n' "$g2b_send" > "$stage_dir/gate-to-beacon.send"
  printf '%s\n' "$g2b_accept" > "$stage_dir/gate-to-beacon.accept-current"
  printf '%s\n' "$g2b_previous" > "$stage_dir/gate-to-beacon.accept-previous"
  printf '%s\n' "$b2g_send" > "$stage_dir/beacon-to-gate.send"
  printf '%s\n' "$b2g_accept" > "$stage_dir/beacon-to-gate.accept-current"
  printf '%s\n' "$b2g_previous" > "$stage_dir/beacon-to-gate.accept-previous"

  for name in "${credential_names[@]}"; do
    chmod 0600 "$stage_dir/$name"
    if [ "$(id -u)" -eq 0 ]; then
      chown root:root "$stage_dir/$name"
    fi
    sync_path "$stage_dir/$name"
    if [ -f "$auth_dir/$name" ]; then
      cp -- "$auth_dir/$name" "$backup_dir/$name"
      chmod 0600 "$backup_dir/$name"
      sync_path "$backup_dir/$name"
    fi
  done

  transaction_started=1
  for name in "${credential_names[@]}"; do
    mv -f -- "$stage_dir/$name" "$auth_dir/$name"
    count=$((count + 1))
    if [ "${HARBOR_SERVICE_AUTH_FAILPOINT:-}" = "after_rename_${count}" ]; then
      exit $((70 + count))
    fi
  done
  sync_path "$auth_dir"
  transaction_started=0
}

case "$mode" in
  prepare|switch|finalize) ;;
  *)
    echo "usage: ensure-harborbeacon-token-env [prepare|switch|finalize]" >&2
    exit 64
    ;;
esac

if [ -L "$auth_dir" ]; then
  echo "refusing symlinked service-auth directory" >&2
  exit 1
fi
install -d -m 0700 "$auth_dir"
chmod 0700 "$auth_dir"
if [ "$(id -u)" -eq 0 ]; then
  chown root:root "$auth_dir"
fi
umask 077

for name in "${credential_names[@]}"; do
  validate_target "$auth_dir/$name"
done

g2b_send="$(read_token_file "$auth_dir/gate-to-beacon.send")"
g2b_accept="$(read_token_file "$auth_dir/gate-to-beacon.accept-current")"
g2b_previous="$(read_token_file "$auth_dir/gate-to-beacon.accept-previous")"
b2g_send="$(read_token_file "$auth_dir/beacon-to-gate.send")"
b2g_accept="$(read_token_file "$auth_dir/beacon-to-gate.accept-current")"
b2g_previous="$(read_token_file "$auth_dir/beacon-to-gate.accept-previous")"

if [ "$mode" = "prepare" ]; then
  legacy_g2b="$(first_valid_legacy HARBOR_GATE_TO_BEACON_TOKEN HARBORBEACON_WEB_API_TOKEN)"
  legacy_b2g="$(first_valid_legacy HARBOR_BEACON_TO_GATE_TOKEN HARBORGATE_BEARER_TOKEN HARBOR_IM_GATEWAY_BEARER_TOKEN IM_AGENT_SERVICE_TOKEN)"

  if ! valid_token "$g2b_accept"; then
    g2b_accept="$(generate_unique_token "$legacy_g2b" "$legacy_b2g")"
  fi
  if ! valid_token "$b2g_accept" || [ "$b2g_accept" = "$g2b_accept" ]; then
    b2g_accept="$(generate_unique_token "$g2b_accept" "$legacy_g2b" "$legacy_b2g")"
  fi
  if ! valid_token "$g2b_send"; then
    if valid_token "$legacy_g2b"; then g2b_send="$legacy_g2b"; else g2b_send="$g2b_accept"; fi
  fi
  if ! valid_token "$b2g_send"; then
    if valid_token "$legacy_b2g"; then b2g_send="$legacy_b2g"; else b2g_send="$b2g_accept"; fi
  fi
  if ! valid_token "$g2b_previous"; then
    if [ "$g2b_send" != "$g2b_accept" ]; then g2b_previous="$g2b_send"; else g2b_previous=""; fi
  fi
  if ! valid_token "$b2g_previous"; then
    if [ "$b2g_send" != "$b2g_accept" ]; then b2g_previous="$b2g_send"; else b2g_previous=""; fi
  fi
elif [ "$mode" = "switch" ]; then
  if ! valid_token "$g2b_accept" || ! valid_token "$b2g_accept" || [ "$g2b_accept" = "$b2g_accept" ]; then
    echo "service-auth prepare phase is incomplete" >&2
    exit 65
  fi
  g2b_send="$g2b_accept"
  b2g_send="$b2g_accept"
else
  if ! valid_token "$g2b_accept" || ! valid_token "$b2g_accept" \
    || [ "$g2b_send" != "$g2b_accept" ] || [ "$b2g_send" != "$b2g_accept" ]; then
    echo "service-auth switch phase is incomplete" >&2
    exit 66
  fi
  g2b_previous=""
  b2g_previous=""
fi

if ! valid_token "$g2b_send" || ! valid_token "$g2b_accept" \
  || ! valid_token "$b2g_send" || ! valid_token "$b2g_accept" \
  || [ "$g2b_accept" = "$b2g_accept" ]; then
  echo "invalid service-auth credential state" >&2
  exit 67
fi

commit_credentials
